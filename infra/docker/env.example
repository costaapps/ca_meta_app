# Placeholder values only. Replace them in the target environment's runtime secret/config store.
NODE_ENV=<development|staging|production>
API_PORT=<internal-port-3000>
API_BIND_ADDRESS=<container-address-0.0.0.0>
API_ALLOWED_HOSTS=<exact-public-hostnames-comma-separated>
API_ALLOWED_ORIGINS=<exact-https-origins-comma-separated>
API_PORTAL_SESSION_RECOVERY_KEY=<protected-random-value-at-least-32-bytes>
API_TRUSTED_PROXIES=<none-or-explicit-proxy-cidrs>
API_DATABASE_HOST=<private-database-host>
API_DATABASE_PORT=<private-database-port>
API_DATABASE_NAME=<database-name>
API_DATABASE_USER=<runtime-database-user>
API_DATABASE_PASSWORD_FILE=/run/secrets/api_database_password
API_DATABASE_CONNECT_TIMEOUT_MS=<100-5000>
# Compose derives migration host/port/name from these API_DATABASE_* values; only the DB account and password differ.

# Public same-origin setting; current schema accepts /api or /api/v1.
WEB_PUBLIC_META_API_BASE_URL=<same-origin-api-path-such-as-/api-or-/api/v1>
