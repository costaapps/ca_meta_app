# Supply this file through a protected environment-specific location; never commit its filled copy.
COMPOSE_PROJECT_NAME=ca-meta-production
NODE_ENV=production
API_PORT=3000
API_BIND_ADDRESS=0.0.0.0
API_ALLOWED_HOSTS=<exact-public-hostname>
API_ALLOWED_ORIGINS=<exact-https-origin-including-port-if-nondefault>
API_PORTAL_SESSION_RECOVERY_KEY=<protected-random-value-at-least-32-bytes>
API_TRUSTED_PROXIES=<trusted-ingress-cidr-list-or-none>
# Empty denies PLATFORM_IDENTITY_ADMIN until an operator configures verified issuer/subject pairs.
API_PLATFORM_IDENTITY_ADMIN_IDENTITIES_JSON=[]
API_DATABASE_HOST=<private-managed-mariadb-host>
API_DATABASE_PORT=3306
API_DATABASE_NAME=<application-database>
API_DATABASE_USER=<least-privilege-runtime-user>
API_DATABASE_CONNECT_TIMEOUT_MS=3000
# Migration endpoint is derived from API_DATABASE_HOST/PORT/NAME in Compose.
MIGRATION_DATABASE_USER=<separate-schema-migrator>
MIGRATION_DATABASE_CONNECT_TIMEOUT_MS=10000
MIGRATION_LOCK_TIMEOUT_SECONDS=30
MIGRATION_STATEMENT_TIMEOUT_SECONDS=300
MIGRATION_MIN_SUPPORTED_API_VERSION=1
WEB_PUBLISH_ADDRESS=0.0.0.0
WEB_PUBLISH_PORT=8080
WEB_PUBLIC_META_API_BASE_URL=/api
CA_META_API_DB_PASSWORD_FILE=<absolute-host-path-to-runtime-secret-file>
CA_META_MIGRATOR_DB_PASSWORD_FILE=<absolute-host-path-to-migration-secret-file>
