# Copy outside the repository and change the project name for every independent local stack.
COMPOSE_PROJECT_NAME=m207-dev-replace-with-unique-id
NODE_ENV=development
API_PORT=3000
API_BIND_ADDRESS=0.0.0.0
API_ALLOWED_HOSTS=localhost,127.0.0.1
API_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_SUITE4_EMBED_ORIGINS=
API_PORTAL_SESSION_RECOVERY_KEY=<generate-a-protected-random-value-at-least-32-bytes>
API_PORTAL_SESSION_IDLE_TIMEOUT_SECONDS=1800
API_PORTAL_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# Leave all three unset until a trusted synthetic issuer/key profile is configured for this environment.
# API_PORTAL_ENTRY_TICKET_ISSUER=
# API_PORTAL_ENTRY_TICKET_AUDIENCE=
# API_PORTAL_ENTRY_TICKET_PUBLIC_KEYS_JSON=
# API_PORTAL_ENTRY_TICKET_CLOCK_SKEW_SECONDS=5
# API_PORTAL_ENTRY_TICKET_MAX_LIFETIME_SECONDS=60
API_TRUSTED_PROXIES=none
# Empty denies PLATFORM_IDENTITY_ADMIN; provision exact verified issuer/subject pairs explicitly.
API_PLATFORM_IDENTITY_ADMIN_IDENTITIES_JSON=[]
API_DATABASE_HOST=database
API_DATABASE_PORT=3306
API_DATABASE_NAME=ca_meta_dev
API_DATABASE_USER=ca_meta_api
API_DATABASE_CONNECT_TIMEOUT_MS=3000
# Migration endpoint is derived from API_DATABASE_HOST/PORT/NAME in Compose.
MIGRATION_DATABASE_USER=ca_meta_migrator
MIGRATION_DATABASE_CONNECT_TIMEOUT_MS=10000
MIGRATION_LOCK_TIMEOUT_SECONDS=30
MIGRATION_STATEMENT_TIMEOUT_SECONDS=300
MIGRATION_MIN_SUPPORTED_API_VERSION=1
WEB_PUBLISH_ADDRESS=127.0.0.1
WEB_PUBLISH_PORT=8080
WEB_PUBLIC_META_API_BASE_URL=/api
WEB_SUITE4_EMBED_ORIGINS=
WEB_PUBLIC_META_AUTHORIZATION_ORIGINS=
CA_META_API_DB_PASSWORD_FILE=<absolute-path-outside-repository>
CA_META_MIGRATOR_DB_PASSWORD_FILE=<different-absolute-path-outside-repository>
CA_META_DEV_DB_ROOT_PASSWORD_FILE=<third-absolute-path-outside-repository>
