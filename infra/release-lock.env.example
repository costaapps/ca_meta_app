# Template only: not a publishable release. M2.09 must create the immutable filled lock.
# Compose prod requires both image values and accepts digest-pinned registry references only.
RELEASE_ID=<semver-plus-source-sha>
SOURCE_REVISION=<40-hex-git-commit-sha>
CA_META_WEB_IMAGE=<confirmed-registry>/ca-meta-web@sha256:<64-hex-image-digest>
CA_META_API_IMAGE=<confirmed-registry>/ca-meta-api@sha256:<64-hex-image-digest>
WEB_SOURCE_REVISION=<same-40-hex-sha-as-source-revision>
API_SOURCE_REVISION=<same-40-hex-sha-as-source-revision>
SCHEMA_VERSION=3
SCHEMA_MIN_COMPATIBLE=3
SCHEMA_MAX_COMPATIBLE=3
