{
  "name": "@ca-meta/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker/main.js",
    "build": "nest build",
    "migrate:deploy": "node dist/database/migrations/cli.js deploy",
    "migrate:status": "node dist/database/migrations/cli.js status",
    "test:m3-10": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/m3-10-privacy.spec.js dist-test/test/m3-10-privacy.integration.spec.js",
    "legacy-import:dry-run": "node dist/legacy-import/legacy-import.cli.js --dry-run --fixture synthetic-inventory.json",
    "test:m3-11": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/m3-11-legacy-import.spec.js",
    "test:m3-12": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/m3-12-asset-catalog.spec.js",
    "test:m5-02": "node ../../tools/m5-02/run-focused-api-test.mjs",
    "test:m5-03": "node ../../tools/m5-03/run-focused-api-test.mjs",
    "test:m5-04": "node ../../tools/m5-04/run-focused-api-test.mjs",
    "test:m4-01": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/m4-01-meta-app-config.spec.js",
    "test:m3-09": "node ../../tools/m3-09/run-focused-test.mjs",
    "test:m3-08": "node ../../tools/m3-08/run-focused-test.mjs",
    "test:m4-02": "npm run build && node ../../tools/m4-02/run-focused-test.mjs",
    "test:m4-03": "node ../../tools/m4-03/run-focused-test.mjs",
    "test:m4-04": "node ../../tools/m4-04/run-focused-test.mjs",
    "test:m4-12": "node ../../tools/m4-12/run-focused-test.mjs",
    "test:m4-13": "node ../../tools/m4-13/run-focused-test.mjs",
    "test:m4-14": "node ../../tools/m4-14/run-focused-test.mjs",
    "test:m5-07": "node ../../tools/m5-07/run-focused-test.mjs",
    "test:m5-07:db": "node ../../tools/m5-07/run-focused-test.mjs --database",
    "lint": "node ../../tools/m2-08/lint-api-boundary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node ../../tools/m2-08/prepare-test-reports.mjs && node --test --experimental-test-coverage --test-reporter=junit --test-reporter=lcov --test-reporter-destination=../../artifacts/test-results/api.junit.xml --test-reporter-destination=../../artifacts/test-results/api.lcov.info dist-test/test/*.spec.js"
  },
  "dependencies": {
    "@ca-meta/contracts": "0.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
