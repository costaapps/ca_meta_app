{
  "synthetic_only": true,
  "meta_quota_gate": {
    "verification_status": "NOT_CONFIRMED",
    "numeric_provider_limits_invented": false,
    "flows": [
      "Facebook",
      "Instagram",
      "WhatsApp-exclusive",
      "Coexistence"
    ],
    "required_evidence": [
      "official-current-documentation",
      "per-config-credential-endpoint-account-scope",
      "sandbox-observed-quota-headers-and-errors",
      "webhook-ack-and-redelivery-contract",
      "pricing-unit-and-effective-date"
    ]
  },
  "scale_triggers": {
    "worker_utilization_to_review": 0.7,
