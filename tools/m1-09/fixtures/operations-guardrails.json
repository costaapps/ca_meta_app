    {"phase": "prepared-import", "exactly_one_owner_per_composite_key": true},
    {"phase": "shadow-read", "exactly_one_owner_per_composite_key": true},
    {"phase": "tenant-channel-pilot", "exactly_one_owner_per_composite_key": true},
    {"phase": "cohort-expansion", "exactly_one_owner_per_composite_key": true},
    {"phase": "final-cutover", "exactly_one_owner_per_composite_key": true},
    {"phase": "retirement", "exactly_one_owner_per_composite_key": true}
  ]
