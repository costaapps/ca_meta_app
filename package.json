{
  "name": "ca-meta-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "fdir": {
      "picomatch": "4.0.7"
    }
  },
  "scripts": {
    "start": "npm run start:web",
    "start:web": "npm run start --workspace=@ca-meta/web",
    "start:api": "npm run start --workspace=@ca-meta/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@ca-meta/web",
    "build:api": "npm run build --workspace=@ca-meta/api",
    "test": "npm run test --workspaces --if-present --",
    "test:web": "npm run test --workspace=@ca-meta/web",
    "test:api": "npm run test --workspace=@ca-meta/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:api": "npm run typecheck --workspace=@ca-meta/api",
    "lint": "npm run lint --workspaces --if-present",
    "check:web-boundary": "npm run lint --workspace=@ca-meta/web",
    "smoke:routes": "npm run build:web && node tools/m2/smoke-web-dist.mjs",
    "check:web-bundle": "npm run build:web && node tools/m2/check-web-bundle.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
